/-!
=============================================================================
## Subspaces
=============================================================================
In this section, we examine preservation of subspaces under linear maps,
characterization of the subspace generated by two subspaces, and characterization
of the subspaces of a quotient vector space.
-/

variable {K : Type*} [Field K] {V : Type*} [AddCommGroup V] [Module K V]

def preimage {W : Type*} [AddCommGroup W] [Module K W] (φ : V →ₗ[K] W) (H : Submodule K W) :
    Submodule K V where
  carrier := φ ⁻¹' H
  zero_mem' := by
    simp
  add_mem' := by
    simp; intros; apply add_mem <;> assumption
  smul_mem' := by
    simp; intros; apply H.smul_mem; assumption

example {S T : Submodule K V} {x : V} (h : x ∈ S ⊔ T) :
    ∃ s ∈ S, ∃ t ∈ T, x = s + t  := by
  rw [← S.span_eq, ← T.span_eq, ← Submodule.span_union] at h
  induction h using Submodule.span_induction with
  | mem y h =>
      rcases h with (hy|hy)
      · use y, hy, 0, T.zero_mem
        module
      · use 0, S.zero_mem, y, hy
        module
  | zero =>
      use 0, S.zero_mem, 0, T.zero_mem
      module
  | add x y hx hy hx' hy' =>
      rcases hx' with ⟨s, hs, t, ht, rfl⟩
      rcases hy' with ⟨s', hs', t', ht', rfl⟩
      use s + s', S.add_mem hs hs', t + t', T.add_mem ht ht'
      module

  | smul a x hx hx' =>
      rcases hx' with ⟨s, hs, t, ht, rfl⟩
      use a • s, S.smul_mem a hs, a • t, T.smul_mem a ht
      module


variable {W : Type*} [AddCommGroup W] [Module K W] (φ : V →ₗ[K] W)

example (E : Submodule K V) (F : Submodule K W) :
    Submodule.map φ E ≤ F ↔ E ≤ Submodule.comap φ F := by
  constructor
  · intro h e eE
    simp; apply h
    use e, eE
  intro h pe inpE
  rcases inpE with ⟨e, eE, rfl⟩
  apply h eE


open Submodule

example (E : Submodule K V) : Submodule K (V ⧸ E) ≃ { F : Submodule K V // E ≤ F } where
  toFun F:= ⟨comap E.mkQ F, by
    intro e eE; rw [mem_comap]
    rw [← E.ker_mkQ] at eE
    rw [eE]; exact F.zero_mem
    ⟩
  invFun := map E.mkQ ∘ (↑)
  left_inv := by
    intro p; dsimp
    rw [map_comap_eq]
    rw [E.range_mkQ]; simp
  right_inv := by
    intro P
    ext x
    dsimp
    simp [comap_map_eq, sup_of_le_left P.2]

/-!
=============================================================================
## Linear Endomorphisms
=============================================================================
This section establishes that the direct sum of the kernels of map evaluations
of two relatively prime polynomials is the kernel of their product's evaluation.
-/

open Polynomial Module LinearMap End

example (P Q : K[X]) (h : IsCoprime P Q) (φ : End K V) : ker (aeval φ P) ⊓ ker (aeval φ Q) = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x xin
  simp [Submodule.mem_inf, LinearMap.mem_ker] at xin
  rcases h with ⟨a, b, eq⟩
  have := congr((aeval φ) $eq.symm x)
  simpa [xin]

example (P Q : K[X]) (h : IsCoprime P Q) (φ : End K V) :
    ker (aeval φ P) ⊔ ker (aeval φ Q) = ker (aeval φ (P*Q)) := by
  ext x
  constructor; swap
  · intro heq1
    have heq2 : x ∈ ker ((aeval φ) (Q*P)) := by rwa [mul_comm] at heq1
    rw [LinearMap.mem_ker, map_mul, End.mul_apply] at heq1
    rw [LinearMap.mem_ker, map_mul, End.mul_apply] at heq2
    rcases h with ⟨H, V, hpq⟩
    have : (((aeval φ) (V*Q)) x) ∈ ker ((aeval φ) P) := by
      apply LinearMap.mem_ker.mpr
      rw [← End.mul_apply, ← map_mul, mul_comm V, ← mul_assoc, mul_comm, map_mul, End.mul_apply, map_mul, End.mul_apply]
      rw [heq1]; simp
    have : (((aeval φ) (H*P)) x) ∈ ker ((aeval φ) Q) := by
      apply LinearMap.mem_ker.mpr
      rw [← End.mul_apply, ← map_mul, mul_comm H, ← mul_assoc, mul_comm, map_mul, End.mul_apply, map_mul, End.mul_apply]
      rw [heq2]; simp
    have xdec := congr((aeval φ) $hpq.symm x)
    simp at xdec; rw [← End.mul_apply, ← map_mul, ← End.mul_apply, ← map_mul, add_comm] at xdec
    rw [xdec]; apply Submodule.add_mem_sup <;> assumption
  intro xin
  rw [Submodule.mem_sup] at xin
  rcases xin with ⟨y, yin, z, zin, rfl⟩
  rw [map_mul, LinearMap.mem_ker, End.mul_apply, ← LinearMap.comp_apply, ← LinearMap.mem_ker]
  have : z ∈ ker ((aeval φ) P ∘ₗ (aeval φ) Q) := by apply (LinearMap.ker_le_ker_comp ((aeval φ) Q) _) zin
  apply Submodule.add_mem; swap; exact this
  rw [LinearMap.mem_ker, LinearMap.comp_apply, ← End.mul_apply, ← map_mul, mul_comm, map_mul, End.mul_apply, ← LinearMap.comp_apply, ← LinearMap.mem_ker]
  apply LinearMap.ker_le_ker_comp ; assumption

/-!
=============================================================================
## Bases
=============================================================================
Here we prove that change of basis preserves the matrix determinant as well
as nontrivial intersection of subspaces whose dimensions sum to greater
than the ambient dimension.
-/

variable {ι : Type*} (B : Basis ι K V) [DecidableEq ι]

open Module LinearMap Matrix

example [Fintype ι] (B' : Basis ι K V) (φ : End K V) :
    (toMatrix B B φ).det = (toMatrix B' B' φ).det := by
  set M := toMatrix B B φ
  set M' := toMatrix B' B' φ
  set P := (toMatrix B B') LinearMap.id
  set P' := (toMatrix B' B) LinearMap.id
  have h : M' = P * M * P' := by
    rw [← toMatrix_comp, ← toMatrix_comp, id_comp, comp_id]
  have P_unit: P' * P = 1 := by rw [← toMatrix_comp, comp_id, toMatrix_id]
  have inv : P' = P⁻¹ := by
    rw [← mul_one P', ← mul_nonsing_inv P, ← mul_assoc, ← toMatrix_comp, comp_id, toMatrix_id, one_mul]
    exact isUnit_det_of_left_inverse P_unit
  rw [inv] at h
  rw [h, det_mul, det_mul, det_nonsing_inv, mul_comm, ← mul_assoc, Ring.inverse_mul_cancel, one_mul]
  exact isUnit_det_of_left_inverse P_unit

example (E F : Submodule K V) [FiniteDimensional K V] (h : finrank K V < finrank K E + finrank K F) :
    Nontrivial (E ⊓ F : Submodule K V) := by
  set dim_inf := finrank K (E ⊓ F : Submodule K V) with i_def
  set dim_E := finrank K E
  set dim_F := finrank K F
  set dim_sup := finrank K (E ⊔ F : Submodule K V)
  rw [← Module.finrank_pos_iff (R := K), ← i_def, ← Nat.add_sub_cancel dim_inf dim_sup, add_comm]
  rw [Submodule.finrank_sup_add_finrank_inf_eq]
  have : dim_sup ≤ finrank K V := Submodule.finrank_le (E ⊔ F)
  calc
    0 = finrank K V - finrank K V := by norm_num
    _ < dim_E + dim_F - finrank K V := by norm_num [h]
    _ ≤ dim_E + dim_F - dim_sup := by gcongr
